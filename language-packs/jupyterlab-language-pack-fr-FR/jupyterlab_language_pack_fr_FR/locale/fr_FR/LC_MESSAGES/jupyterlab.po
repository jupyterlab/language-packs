#: /packages/application-extension/schema/shell.json:/properties/dockPanelPadding/description
msgctxt "settings"
msgid "Whether to show padding around the main dock panel area. Disable for a more compact layout."
msgstr "Afficher/Masquer l'espace autour du panneau principal du dock. Désactiver pour une disposition plus compacte."

#: /packages/application-extension/schema/shell.json:/properties/dockPanelPadding/title
msgctxt "settings"
msgid "Dock panel padding"
