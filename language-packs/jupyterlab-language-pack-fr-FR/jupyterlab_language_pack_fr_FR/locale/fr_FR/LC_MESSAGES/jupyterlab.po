msgstr "Mode pour masquer les widgets du panneau principal"

#: /packages/application-extension/schema/shell.json:/properties/layout/description
msgctxt "settings"
msgid "Overrides default widget position in the application layout\n"
"e.g. to position terminals in the right sidebar in multiple documents mode and in the down are in single document mode, {\n"
"  \"single\": { \"Terminal\": { \"area\": \"down\" } },\n"
"  \"multiple\": { \"Terminal\": { \"area\": \"right\" } }\n"
"}."
msgstr "Remplace la position par défaut du widget dans la disposition de l'application\n"
"par ex. pour positionner les terminaux dans la barre latérale droite en mode documents multiples et dans le bas sont en mode document unique, {\n"
"  \"single\": { \"Terminal\": { \"area\": \"down\" } },\n"
"  \"multiple\": { \"Terminal\": { \"area\": \"right\" }\n"
"}."

#: /packages/application-extension/schema/shell.json:/properties/layout/title
msgctxt "settings"
msgid "Customize shell widget positioning"
msgstr "Personnaliser le positionnement des widgets"

#: /packages/application-extension/schema/shell.json:/properties/optimizeResize/description
msgctxt "settings"
msgid "Freeze panel dimensions during handle drag to improve resize performance when panels contain heavy DOM content."
msgstr "Geler les dimensions du panneau lors de leur redimensionnement pour améliorer les performances lorsque les panneaux contiennent beaucoup d'éléments."

#: /packages/application-extension/schema/shell.json:/properties/optimizeResize/title
msgctxt "settings"
msgid "Optimize panel resize"
msgstr "Optimiser le redimensionnement des panneaux"

