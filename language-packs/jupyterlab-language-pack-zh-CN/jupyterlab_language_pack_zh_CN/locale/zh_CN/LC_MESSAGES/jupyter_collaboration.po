msgstr "分享 Jupyter 服务器链接"

#: packages/collaboration/src/sharedlink.ts:438
msgid "Type to search for a user or a group to share your server with..."
msgstr "输入用户或者群组的名称并进行搜索，以便共享您的服务器..."

#: packages/collaboration/src/sharedlink.ts:466
msgid "Warning: Anyone you share this server with will have access to all your files, not just the currently open file."
msgstr "警告：与您共享此服务器的任何人都将能够访问您所有的文件，而不仅仅是当前打开的文件。"

#: packages/collaboration/src/sharedlink.ts:473
msgid "If your Hub administrator allows it, you can create another server dedicated to sharing a specific project."
msgstr "如果您的 Hub 管理员允许，您可以创建另一台服务器来专门共享某个特定项目。"

#: packages/collaboration/src/sharedlink.ts:495 packages/collaboration/src/sharedlink.ts:552
msgid "Group %1"
msgstr "群组 %1"

#: packages/collaboration/src/sharedlink.ts:526
msgid "Shared with"
msgstr "已共享给"

#: packages/collaboration/src/sharedlink.ts:528
msgid "Shared since"
msgstr "共享开始自"

#: packages/collaboration/src/sharedlink.ts:530
msgid "Actions"
msgstr "操作"

#: packages/collaboration/src/sharedlink.ts:540
msgid "Your server is not shared to anybody yet. You can search for users and groups above."
msgstr "您的服务器尚未与任何人共享。您可以在上方搜索用户和群组。"

#: packages/collaboration/src/sharedlink.ts:573
msgid "Revoke"
msgstr "撤销"

#: packages/collaboration/src/sharedlink.ts:653
msgid "Security warning!"
msgstr "安全警告！"

#: packages/collaboration/src/sharedlink.ts:656
msgid "Anyone with this link has full access to your notebook server, including all your files!"
msgstr "任何拥有此链接的人都可以完全访问您的笔记本服务器，包括所有文件！"

#: packages/collaboration/src/sharedlink.ts:663
msgid "Please be careful who you share it with."
msgstr "请注意谁是分享者。"

#: packages/collaboration/src/sharedlink.ts:669
msgid "They will be able to access this server AS YOU."
msgstr "他们将能够像您一样访问此服务器。"

#: packages/collaboration/src/sharedlink.ts:674
msgid "To revoke access, go to File -> Hub Control Panel, and restart your server."
msgstr "要撤销访问权限，请转到“文件”->“中心控制面板”，并重新启动您的服务器。"

#: packages/collaboration/src/sharedlink.ts:682
msgid "Currently, there is no way to revoke access other than shutting down your server."
msgstr "目前，除了关闭您的服务器外，没有其他撤销访问权限的方法。"

#: packages/collaboration/src/sharedlink.ts:694
msgid "Only users with `access:servers` permissions for this server will be able to use this link."
msgstr "只有在此服务器拥有“access:servers”权限的用户才能使用此链接。"

#: packages/collaboration/src/sharedlink.ts:701
msgid "Only authenticated users will be able to use this link."
msgstr "只有经过身份验证的用户才能使用此链接。"

#: packages/collaboration/src/sharedlink.ts:726
msgid "Include token in URL"
msgstr "在URL中包含令牌"

